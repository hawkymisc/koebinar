# Copy to .env.production on the server and replace every change-me value.
# Never commit .env.production.
KOEBINAR_DEFAULT_AUTH_TOKEN=change-me-random-operator-token
# For multiple workspaces, clear KOEBINAR_DEFAULT_AUTH_TOKEN and configure:
# KOEBINAR_TENANTS_JSON=[{"id":"acme","name":"Acme Inc.","access_token":"change-me-acme-token"}]
KOEBINAR_MASTER_KEY=change-me-random-master-key

# Register OrcaRouter and ElevenLabs keys through the authenticated integrations API (BYOK).
KOEBINAR_ALLOW_SYSTEM_LLM_KEY=false
KOEBINAR_ALLOW_SYSTEM_TTS_KEY=false
KOEBINAR_LLM_MODEL=orcarouter/auto

# OrcaRouter's hosted adaptive router. Long non-streaming generations may take
# several minutes, so the response read timeout is separate from connect/write.
KOEBINAR_LLM_MODEL=orcarouter/auto
KOEBINAR_ORCAROUTER_READ_TIMEOUT_SEC=600
KOEBINAR_ORCAROUTER_MAX_RETRIES=1
KOEBINAR_ORCAROUTER_RETRY_BACKOFF_SEC=1
KOEBINAR_ORCAROUTER_RETRY_MAX_DELAY_SEC=60

# Caddy stays on internal HTTP. Cloudflare Tunnel and the workers.dev Worker
# provide the public HTTPS endpoint without exposing this port on Lightsail.
KOEBINAR_SITE_ADDRESS=:80
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
