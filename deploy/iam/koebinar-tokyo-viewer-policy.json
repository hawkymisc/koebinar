{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyLightsailOutsideTokyo",
      "Effect": "Deny",
      "Action": "lightsail:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "ap-northeast-1"
        }
      }
    },
    {
      "Sid": "ReadLightsailInTokyo",
      "Effect": "Allow",
      "Action": [
        "lightsail:Get*",
        "lightsail:Is*"
      ],
      "Resource": "*"
    }
  ]
}
